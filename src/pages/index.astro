---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CommunityMap from '../components/CommunityMap.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Footer from '../components/Footer.astro';
import { conference, workshops } from '../data/conference';

const saturdayEvents = [
  { time: '10:00–14:00', title: 'Takimi i Asamblesë', text: 'Sesioni i brendshëm i punës ku organizatorët përcaktojnë prioritetet, përgjegjësitë dhe hapat e ardhshëm të rrjetit.', agenda: ['Përditësimi nga Bordi', 'Raportimi i qyteteve', 'Iniciativat dhe vendimet'], image: '/assets/inst_starting.png', restricted: true, href: '/organizers/' },
  { time: '18:00–19:30', title: 'Eventi me të ftuar', text: 'Një sesion publik në DUA kushtuar vizionit, zhvillimit dhe produktit të Illyrian Brains, me një folës të ftuar.', agenda: ['Hapja e eventit', 'Fjala kryesore', 'Vizioni dhe produkti i IB'], image: '/assets/inst_global_serious.png', location: 'Dua', query: 'Dua+Space+Tirana' },
  { time: '19:30 e tutje', title: 'Networking dhe mbrëmje e lirë', text: 'Mbrëmja përmbyllëse te Oborri krijon hapësirë për biseda, lidhje të reja dhe mundësi konkrete bashkëpunimi.', agenda: ['Darkë bufe', 'Njohje dhe diskutime', 'Muzikë dhe komunitet'], image: '/assets/inst_global.png', location: 'Oborri', query: 'Oborri+Tirana' },
];

const workshopImages = [
  { src: '/assets/inst_workshop.png', alt: 'Pjesëmarrës gjatë një punëtorie të Illyrian Brains' },
  { src: '/assets/inst_meetup.png', alt: 'Profesionistë gjatë një takimi të Illyrian Brains' },
  { src: '/assets/inst_global_serious.png', alt: 'Folës gjatë një prezantimi të Illyrian Brains' },
  { src: '/assets/inst_global.png', alt: 'Pjesëmarrës duke biseduar gjatë një takimi të Illyrian Brains' },
  { src: '/assets/inst_starting.png', alt: 'Pjesëmarrës gjatë një sesioni pune të Illyrian Brains' },
];
---
<BaseLayout title={`IB ${conference.name} · ${conference.city}`} description={`${conference.description} ${conference.city}, ${conference.dates}.`}>
  <Header />
  <main class="landing-page">
    <Hero />

    <section class="section day-section friday-section" id="program">
      <div class="container day-content">
          <header class="day-heading">
            <div class="day-heading-copy"><p class="day-date"><span>E premte</span>18 Shtator</p><h2>Mbrëmja e mirëseardhjes</h2><p>Hapja joformale e IB Global, krijuar për takimet e para, prezantimet dhe njohjen mes pjesëmarrësve.</p></div>
          </header>
          <article class="event-list-card friday-event">
            <div class="event-list-copy">
              <div class="card-meta"><span>Mbrëmje</span><small><a class="location-link" href="https://www.google.com/maps/search/?api=1&query=Dua+Space+Tirana" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>Dua</a></small></div>
              <h3>HappyHour i përbashkët</h3>
              <p>Një mjedis i hapur për t’u prezantuar, për të takuar anëtarët e rinj dhe për të nisur fundjavën me komunitetin.</p>
              <ul class="mini-agenda"><li>Mirëseardhja</li><li>Prezantime të shkurtra</li><li>Biseda të lira</li></ul>
            </div>
            <div class="event-image event-image-collage">
              <img src="/assets/inst_happyhour.png" alt="Pjesëtarë të komunitetit gjatë një mbrëmjeje të Illyrian Brains" loading="lazy" />
              <img src="/assets/inst_global.png" alt="Anëtarë të rrjetit duke biseduar gjatë një eventi" loading="lazy" />
              <img src="/assets/inst_meetup.png" alt="Pjesëmarrës të Illyrian Brains të mbledhur së bashku" loading="lazy" />
            </div>
          </article>
      </div>
    </section>

    <section class="section day-section saturday-section" id="saturday">
      <div class="container day-content">
          <header class="day-heading">
            <div class="day-heading-copy"><p class="day-date"><span>E shtunë</span>19 Shtator</p><h2>Rrjeti, vizioni dhe bashkëpunimi</h2><p>Një ditë e strukturuar nga puna e Asamblesë te eventi kryesor dhe bisedat që vazhdojnë gjatë mbrëmjes.</p></div>
          </header>
          <div class="saturday-grid stacked-cards">
            {saturdayEvents.map((event) => (
              event.restricted ? (
                <details class="session-item no-index organizers-event">
                  <summary>
                    <span class="session-summary-text">
                      <span class="session-time">{event.time}</span>
                      <h3><a href={event.href} onclick="event.stopPropagation()">{event.title} ↗</a></h3>
                      <span class="session-tags"><small class="restricted-label">Vetëm organizatorët</small></span>
                    </span>
                    <span class="session-toggle" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
                  </summary>
                  <div class="session-body">
                    <div class="session-body-copy">
                      <p>{event.text}</p>
                      <ul class="mini-agenda">{event.agenda.map((item) => <li>{item}</li>)}</ul>
                    </div>
                    <div class="session-body-image"><img src={event.image} alt={`Pamje nga ${event.title.toLowerCase()}`} loading="lazy" /></div>
                  </div>
                </details>
              ) : (
                <article class="event-card" tabindex="0">
                  <div class="event-card-copy">
                    <div class="card-meta">
                      <span>{event.time}</span>
                      {event.location ? <small><a class="location-link" href={`https://www.google.com/maps/search/?api=1&query=${event.query}`} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>{event.location}</a></small> : null}
                    </div>
                    <h3>{event.title}</h3>
                    <p>{event.text}</p>
                    <ul class="mini-agenda">{event.agenda.map((item) => <li>{item}</li>)}</ul>
                  </div>
                  <div class="event-image"><img src={event.image} alt={`Pamje nga ${event.title.toLowerCase()}`} loading="lazy" /></div>
                </article>
              )
            ))}
          </div>
      </div>
    </section>

    <section class="section day-section sunday-section" id="sunday">
      <div class="container day-content">
          <header class="day-heading">
            <div class="day-heading-copy"><p class="day-date"><span>E diel</span>20 Shtator</p><h2>Punëtori dhe ligjërata</h2><p>Takime tematike në <a class="inline-location-link" href="https://www.google.com/maps/search/?api=1&query=Dua+Space+Tirana" target="_blank" rel="noreferrer">Dua</a>, me fokus te shkëmbimi i ekspertizës, diskutimi i sfidave dhe krijimi i bashkëpunimeve të reja.</p></div>
            <a class="organizer-callout proposal-callout" href="mailto:illyrianbrains@gmail.com?subject=Propozim%20p%C3%ABr%20pun%C3%ABtori%20ose%20ligj%C3%ABrat%C3%AB%20-%20IB%20Global%202026&body=P%C3%ABrsh%C3%ABndetje%2C%0A%0AD%C3%ABshiroj%20t%C3%AB%20propozoj%20nj%C3%AB%20pun%C3%ABtori%20ose%20ligj%C3%ABrat%C3%AB%20p%C3%ABr%20IB%20Global%202026.%0A%0ATitulli%3A%0AFormati%3A%0AP%C3%ABrshkrimi%20i%20shkurt%C3%ABr%3A%0AKoh%C3%ABzgjatja%3A%0AEmri%20dhe%20kontakti%3A%0A">
              <span>Ndani ekspertizën tuaj</span>
              <strong>Propozoni një sesion</strong>
              <i aria-hidden="true">↗</i>
            </a>
          </header>
          <div class="session-list">
            {workshops.map((workshop, index) => (
              <details class="session-item">
                <summary>
                  <span class="session-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="session-summary-text">
                    <span class="session-time">{workshop.time}</span>
                    <h3>{workshop.title}</h3>
                    <span class="session-tags"><span class="session-tag">{workshop.type}</span><span class="session-tag session-tag-room">{workshop.room}</span></span>
                  </span>
                  <span class="session-toggle" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
                </summary>
                <div class="session-body">
                  <div class="session-body-copy">
                    <p>{workshop.text}</p>
                    <ul class="mini-agenda">{workshop.agenda.map((item) => <li>{item}</li>)}</ul>
                    <div class="session-speaker">
                      <span class="session-speaker-avatar">{workshop.speaker.initials}</span>
                      <span class="session-speaker-name">Me <strong>{workshop.speaker.name}</strong></span>
                      {workshop.speaker.linkedin && (
                        <a class="session-speaker-linkedin" href={workshop.speaker.linkedin} target="_blank" rel="noreferrer" aria-label={`${workshop.speaker.name} në LinkedIn`}>in</a>
                      )}
                    </div>
                  </div>
                  <div class="session-body-image"><img src={workshopImages[index % workshopImages.length].src} alt={workshopImages[index % workshopImages.length].alt} loading="lazy" /></div>
                </div>
              </details>
            ))}
          </div>
      </div>
    </section>

    <section class="section venue-section" id="venue">
      <div class="container venue-layout venue">
        <div class="venue-copy">
          <SectionTitle kicker="Tiranë" title="Dy vende, një eksperiencë" text="DUA dhe Oborri janë përballë njëri-tjetrit, duke e mbajtur programin e fundjavës të lidhur, të afërt dhe të lehtë për t’u ndjekur." />
        </div>
        <div class="venue-grid">
          <article class="venue-card">
            <div class="venue-pin" aria-hidden="true"><span></span></div>
            <span>Eventi · Grupet e punës</span>
            <strong>DUA</strong>
            <p>Hapësira kryesore e IB Global për takimet, prezantimet dhe sesionet profesionale.</p>
            <div class="venue-schedule"><span>E premte · Mbrëmje</span><span>E shtunë · 10:00–14:00</span><span>E shtunë · 18:00–19:30</span><span>E diel · 10:00–12:20</span></div>
            <a class="venue-map-link" href="https://www.google.com/maps/search/?api=1&query=Dua+Space+Tirana" target="_blank" rel="noreferrer">Hape në hartë <span>↗</span></a>
          </article>
          <article class="venue-card">
            <div class="venue-pin" aria-hidden="true"><span></span></div>
            <span>Njohje · Darkë</span>
            <strong>Oborri</strong>
            <p>Ambienti përballë DUA ku komuniteti mblidhet për biseda më të lira, njohje dhe darkë.</p>
            <div class="venue-schedule"><span>E shtunë · 19:30 e tutje</span></div>
            <a class="venue-map-link" href="https://www.google.com/maps/search/?api=1&query=Oborri+Tirana" target="_blank" rel="noreferrer">Hape në hartë <span>↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <CommunityMap />

    <section class="section partners-section" id="partners">
      <div class="container partners-inner">
        <header class="partners-heading">
          <div>
            <p class="eyebrow">Partneritetet</p>
            <h2>Partneritet që<br />krijon vlerë.</h2>
          </div>
          <div class="partners-intro">
            <p>Bashkëpunojmë me kompani dhe organizata që duan të lidhen me profesionistë shqiptarë, të ndajnë ekspertizën e tyre dhe të krijojnë mundësi me ndikim afatgjatë.</p>
            <a class="partner-button" href="mailto:illyrianbrains@gmail.com?subject=Partneritet%20me%20IB%20Global%202026">Na shkruani <span aria-hidden="true">↗</span></a>
          </div>
        </header>

        <div class="partner-benefits" aria-label="Përfitimet e partneritetit">
          <article>
            <span>01</span>
            <h3>Gjeni kontakte</h3>
            <p>Njihuni me njerëz të rinj dhe hapni mundësi për bashkëpunime të vlefshme.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Zhvilloni rrjetin</h3>
            <p>Takoni profesionistë, sipërmarrës dhe organizatorë nga rrjeti shqiptar në botë.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Mbështetni komunitetin</h3>
            <p>Ndihmoni që më shumë dije, ide dhe mundësi të kthehen në bashkëpunime me vlerë.</p>
          </article>
        </div>

        <p class="partners-note"><span></span> Partnerët tanë do t’i prezantojmë së shpejti.</p>
      </div>
    </section>

    <section class="register-section" id="register">
      <div class="container register-inner">
        <div class="register-copy">
          <p class="eyebrow">REGJISTRIMI</p>
          <h2>Rezervo vendin tënd në IB Global.</h2>
          <p class="register-intro">Tri ditë për t’u ritakuar, për të shkëmbyer ide dhe për të ndërtuar bashkë hapin e radhës të komunitetit.</p>
          <div class="register-facts" aria-label="Detajet e konferencës">
            <div class="register-fact"><span>Kur</span><strong>{conference.dates}</strong></div>
            <div class="register-fact"><span>Ku</span><strong>Tiranë, Shqipëri</strong></div>
            <div class="register-fact"><span>Përfshin</span><strong>Programin e plotë</strong></div>
          </div>
        </div>
        <div class="paypal-checkout">
          <div class="checkout-body">
            <p class="checkout-label">Paguaj dhe konfirmo vendin</p>
            <stripe-buy-button
              buy-button-id="buy_btn_1U6obuAoGYzPdB47sCgWmlOT"
              publishable-key="pk_live_51U64ShAoGYzPdB47S0s87l5peuSWDscAjjoYPCXj015UHNYjDuoK9PrO5uws4FBMkwarf1a3DyPC4jJxM9VHHn6e00P32zBt5V"
            ></stripe-buy-button>
            <div class="checkout-note">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 8.3 7 10 4.2-1.7 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
              <span>Pagesë e sigurt përmes Stripe. Email-i juaj do të përdoret për konfirmimin e regjistrimit.</span>
            </div>
          </div>
        </div>
      </div>
      <script async is:inline src="https://js.stripe.com/v3/buy-button.js"></script>
    </section>
    <script is:inline>
      const revealItems = document.querySelectorAll('.day-content, .venue, .register-inner');
      revealItems.forEach((item) => item.classList.add('reveal-item'));

      if (!('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12 });

      revealItems.forEach((item) => revealObserver.observe(item));
      }

    </script>
  </main>
  <Footer />
</BaseLayout>
