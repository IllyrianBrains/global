---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const agenda = [
  { time: '10:00–10:10', duration: '10 min', title: 'Hapja dhe objektivat e ditës', text: 'Mirëseardhje, prezantim i shkurtër i pjesëmarrësve, rregullat e sesionit.' },
  { time: '10:10–10:50', duration: '40 min', title: 'Update i përgjithshëm i iniciativave të IB Network dhe vizioni për të ardhmen', text: 'Statusi i iniciativave në vazhdim, çfarë kemi arritur që nga Global II, dhe prezantimi i vizionit për vitin e ardhshëm. 25 min prezantim + 15 min pyetje.' },
  { time: '10:50–11:15', duration: '25 min', title: 'Regjistrimi i OJF-së në Tiranë', text: 'Ku ndodhemi me procesin, hapat ligjorë të mbetur, çfarë ndryshon për rrjetin pas regjistrimit.' },
  { time: '11:15–11:45', duration: '30 min', title: 'Website update', text: 'Demo i versionit të ri, çfarë i duhet nga çdo qytet (përmbajtje, kontakte, evente), afati i publikimit.' },
  { time: '11:45–12:00', duration: '15 min', title: 'Pushim kafeje', text: '' },
  { time: '12:00–12:20', duration: '20 min', title: 'IB Membership: abonimi vjetor dhe çfarë përfshin', text: 'Propozimi i modelit të anëtarësisë, çmimi vjetor, përfitimet për anëtarët dhe roli i qyteteve në rekrutim. Diskutim dhe vendim.' },
  { time: '12:20–13:20', duration: '60 min', title: 'Round the table standup: feedback nga përfaqësuesit lokalë të IB', text: 'Çdo qytet në 5 minuta: statusi i komunitetit, çfarë funksionon, çfarë pengon, çfarë i kërkon rrjetit. Shënuesi mbledh temat e përbashkëta për pikën tjetër.' },
  { time: '13:20–13:50', duration: '30 min', title: 'Standardizimi i operacioneve across local chapters', text: 'Local Community Playbook: ritmi mujor, emërtimi i grupeve, raportimi minimal, kodi i sjelljes. Çfarë adoptojmë njësoj kudo dhe çfarë mbetet lokale.' },
  { time: '13:50–14:00', duration: '10 min', title: 'Përmbledhje, vendime dhe hapat e radhës', text: 'Lista e vendimeve, përgjegjësi dhe afati për çdo veprim. Kalim te dreka.' },
];

const teamBuildingIdeas = [
  { title: 'Harta e IB', meta: 'Hapje · 15–20 min', points: ['Vendosni qytetin ose shtetin tuaj në hartë.', 'Shënoni çfarë mund t’i ofroni rrjetit.', 'Gjeni qytete me të cilat mund të lidheni.'] },
  { title: 'Speed Networking', meta: 'Në dyshe · 25–30 min', points: ['Bisedoni 4–5 minuta me një person.', 'Ndani çfarë po ndërtoni dhe çfarë ju duhet.', 'Mbylleni me një mënyrë konkrete për të ndihmuar.'] },
  { title: '3 gjëra për IB', meta: 'Grupe të vogla · 25 min', points: ['Çfarë duhet të vazhdojmë?', 'Çfarë duhet të ndryshojmë?', 'Çfarë duhet të fillojmë?'] },
  { title: 'IB Challenge', meta: 'Ekipe të përziera · 30 min', points: ['Merrni një sfidë konkrete të komunitetit.', 'Punoni 20 minuta mbi një zgjidhje praktike.', 'Prezantoni idenë dhe hapin e parë.'] },
  { title: 'Project Marketplace', meta: 'Ide dhe projekte · 30 min', points: ['Prezantoni idenë ose projektin në një minutë.', 'Zgjidhni projektin ku dëshironi të ndihmoni.', 'Krijoni grupin e punës dhe caktoni hapin e parë.'] },
  { title: 'Human Bingo - IB Edition', meta: 'Hapje · 15–20 min', points: ['Merrni një fletë me përvoja të ndryshme.', 'Gjeni persona që përputhen me secilën pikë.', 'Plotësoni rreshtin duke njohur njerëz të rinj.'] },
  { title: 'Random Lunch Tables', meta: 'Gjatë drekës', points: ['Përzieni qytetet dhe profesionet në çdo tavolinë.', 'Shmangni uljen vetëm me njerëzit që njihni.', 'Përdorni një pyetje të përbashkët për të nisur bisedën.'] },
  { title: 'Letër për IB 2027', meta: 'Mbyllje · 15 min', points: ['Diskutoni çfarë dëshironi të arrijë IB.', 'Shkruani 2–3 fjali nga çdo tavolinë.', 'Lexojini në fund dhe ruajini për vitin tjetër.'] },
];

const contributorColumns = [
  ['Bordi', 'Drejtimi', 'Qeverisja', 'Prioritetet', 'Vendimmarrja', 'Statuti', 'Përgjegjësia', 'Vazhdimësia'],
  ['Qytetet', 'Tiranë', 'Berlin', 'London', 'New York', 'Milano', 'Zürich', 'Köln'],
  ['Ekipet', 'Teknologji', 'Shëndetësi', 'Dizajn', 'Komunikim', 'Financë', 'Ligj', 'Akademi'],
  ['Projektet', 'Eventet', 'Mentorimi', 'Grupet e punës', 'Iniciativat', 'Partneritetet', 'Platforma IB', 'Bashkëpunimet'],
];
---
<BaseLayout title="Vetëm për organizatorët · IB Global 2026" description="Hapësira e punës për organizatorët e IB Global 2026.">
  <Header />
  <main class="organizers-page">
    <section class="organizers-hero grid-surface">
      <div class="container organizers-hero-inner">
        <div><p class="eyebrow">VETËM PËR ORGANIZATORËT · IB GLOBAL 2026</p><h1>Takimi i<br />Asamblesë</h1></div>
        <div class="organizers-brief"><span>E shtunë · 19 Shtator</span><strong>10:00–14:00</strong><p>Një sesion pune për t’u njohur më mirë, për të ndarë çfarë po mësojmë dhe për t’i kthyer prioritetet e rrjetit në hapa konkretë.</p><div class="organizer-reference-links"><a href="https://illyrianbrains.org" target="_blank" rel="noreferrer">Faqja kryesore ↗</a><a href="https://illyrianbrains.org/statuti" target="_blank" rel="noreferrer">Lexo Statutin ↗</a></div></div>
      </div>
    </section>

    <section class="section organizers-agenda grid-surface">
      <div class="container organizer-layout">
        <header class="organizer-section-title"><p class="eyebrow">Agjenda</p><h2>Hapësirë për çdo qytet.</h2><p>Një rrjedhë e thjeshtë: dëgjojmë çështjet, punojmë mbi temat e përbashkëta dhe largohemi me hapa të qartë.</p></header>
        <div class="internal-agenda">{agenda.map((item, index) => (<article><time>{item.time}<span class="agenda-duration">{item.duration}</span></time><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3>{item.text && <p>{item.text}</p>}</div></article>))}</div>
      </div>
    </section>

    <section class="section organizer-exercises grid-surface">
      <div class="container">
        <header class="organizer-section-title exercises-heading"><p class="eyebrow">Ide për Team-Building</p><h2>Zgjidhini para takimit.</h2><p>Këto aktivitete mund të kombinohen sipas kohës dhe qëllimit të grupit. Organizatorët zgjedhin paraprakisht idetë që duan të përfshihen në program.</p></header>
        <div class="exercise-selection-note"><span>8 ide</span><p>Rekomandim: zgjidhni një aktivitet për hapjen, një për bashkëpunim dhe një për mbylljen.</p></div>
        <div class="exercise-grid">
          {teamBuildingIdeas.map((idea, index) => (
            <article>
              <div class="exercise-top"><span>{String(index + 1).padStart(2, '0')}</span><small>Ide për përzgjedhje</small></div>
              <p class="exercise-label">{idea.meta}</p>
              <h3>{idea.title}</h3>
              <ul>{idea.points.map((point) => <li>{point}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section city-preparation grid-surface">
      <div class="container city-preparation-layout">
        <header class="organizer-section-title"><p class="eyebrow">5 minuta për çdo qytet</p><h2>Ejani me propozime.</h2><p>Nuk nevojitet prezantim. Përdorni pesë minutat për t’u dhënë të tjerëve kontekst të mjaftueshëm që të mund t’ju ndihmojnë.</p></header>
        <div class="city-preparation-grid">
          <article><span>01</span><div><h3>Çështja</h3><p>Cila është sfida më e rëndësishme që doni të sillni në diskutim?</p></div></article>
          <article><span>02</span><div><h3>Çfarë keni provuar?</h3><p>Ndani shkurt çfarë ka funksionuar, çfarë jo dhe çfarë keni mësuar.</p></div></article>
          <article><span>03</span><div><h3>Çfarë ju duhet?</h3><p>Kërkoni qartë një ide, përvojë, kontakt ose mbështetje nga organizatorët e tjerë.</p></div></article>
        </div>
      </div>
    </section>

    <section class="contributors-section">
      <div class="container contributors-layout">
        <div class="contributors-copy"><p class="eyebrow">NJË RRJET · SHUMË EKIPE</p><h2>Asambleja i lidh të gjitha.</h2><p>Qytetet, grupet profesionale dhe ekipet mbështetëse sjellin perspektiva të ndryshme në një drejtim të përbashkët për Illyrian Brains.</p><small>Çdo emër, qytet dhe rol është pjesë e së njëjtës punë.</small></div>
        <div class="community-wall contributor-wall" aria-label="Ekipet kontribuese të Illyrian Brains">{contributorColumns.map((items, columnIndex) => (<div class:list={['community-column', { 'accent-column': columnIndex % 2 === 1 }]}>{[...items, ...items].map((item) => <span>{item}</span>)}</div>))}</div>
      </div>
    </section>

    <section class="section followup-section grid-surface">
      <div class="container followup-card">
        <div><p class="eyebrow">Nga Asambleja te rrjeti</p><h2>Vendimi kthehet në veprim.</h2></div>
        <ol><li><strong>Brenda 24 orësh</strong><span>Shënimet dhe vendimet ndahen me kontribuesit.</span></li><li><strong>Brenda 7 ditësh</strong><span>Pronarët konfirmojnë planin dhe afatet.</span></li><li><strong>Pas 30 ditësh</strong><span>Kontroll i progresit dhe zhbllokim i pengesave.</span></li></ol>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
